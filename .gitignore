# Regenerable pipeline intermediates (rebuild via parse_pdfs.py + geocode.py + assign_nta.py + fetch_hpd.py)
buildings.json
buildings_geo.json
buildings_geo_nta.json
buildings_hpd.json

# Secrets — local-only config (API keys). Use config.example.js as the template.
config.js

# Scraper / fetcher logs
scrape.log
fetch_hpd.log

# OS / editor cruft
.DS_Store

# Generated SEO pages (rebuild via build_seo.py)
seo/

# gzip copies of the map data blobs (regenerate with gzip -9 -k)
buildings.min.json.gz
sf/buildings.min.json.gz
la/buildings.min.json.gz
dc/buildings.min.json.gz

# honest-lastmod state for build_seo.py
seo_lastmod.json

# DC RentRegistry export CSVs (~130 MB, re-downloaded by build_dc.py)
dc_raw/

# nightly listing history snapshots (droplet-side)
listings_archive/
listings_zumper.json
listings_apify.json
apify_export.json

# managing-agent phone cache (regenerable; may contain harvested business numbers)
agent_phones.json

# saved-building alert job state (droplet-side)
alert_snapshot.json
buildings_cache.json

# growth engine. The ledger itself (techniques.json, keywords.json,
# results.jsonl, journal.md) IS tracked: it is the year-end record of what was
# tried and what worked, and the daily review agent reads it from the checkout.
# Only machine-local scratch and third-party research stay out.
growth_out/
growth/state.json
growth/.anthropic_key

# Outreach research names real third-party organisations and drafts addressed to
# them. This repo is public — these stay local.
growth/prospects.json
growth/outreach_drafts/

# droplet-side secrets that live inside the growth checkout
growth.env
indexnow.key

# regenerable from Supabase (build_hpd_contacts.py); 46k owner/manager records
hpd_contacts.json

# Search Console service-account key (droplet copy)
growth/.gsc_key.json

# Featured-tile output. Regenerated from the agents' own pages every morning
# and served from the docroot, so tracking it only guarantees a daily conflict
# between the droplet's run and the laptop's. The photos additionally are
# somebody else's copyrighted images and this repo is public. Rebuild both with
# featured_rerentals.py --apply.
featured.json
featured/img/

# Python bytecode
__pycache__/
*.pyc
rerental_history.json
supabase/.temp/
founding_sent.json
housing_connect.json

# Council-office contact list (public office addresses; rebuilt by build_council.py,
# deliberately not published — see growth/council_outreach.md)
council_outreach.csv

# Derived from buildings.min.json by split_hpd.py; regenerated on every
# refresh, and large. The source blob stays tracked.
buildings.slim.json
buildings.slim.json.gz
buildings.hpd.json
buildings.hpd.json.gz
