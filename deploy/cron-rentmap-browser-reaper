# Headless-browser reaper. Installed at /etc/cron.d/rentmap-browser-reaper.
# 2026-09-30: a build_vacancies.py run left its Chromium behind; with the next
# run's on top, the 2 GB droplet ran out of memory and stalled every site on
# it (findacrib.com, Crease, Haukley, NEMO) for most of an hour until the OOM
# killer fired. No browser job here runs longer than ~45 minutes (vacancies
# has a 45m timeout), so any headless Chrome older than 90 minutes is an
# orphan: kill it.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/15 * * * * root ps -eo pid=,etimes=,comm= | awk '$3 ~ /chrome/ && $2 > 5400 {print $1}' | xargs -r kill -9
