# /etc/cron.d/rentmap-errors — mirrored from deploy/cron-rentmap-errors.
# Errors users actually hit: web JS, pages that died mid-work, iPhone app
# failures, 5xx, API tracebacks and feeds that stopped refreshing.
# Hourly run mails only on something new or broken; the 08:10 ET run always
# sends the day's digest if anything is open. Recipient: ERROR_REPORT_EMAIL
# in /etc/findacrib/env/errors.env (this file is mirrored into a PUBLIC repo —
# no addresses here). Runs as `facops` since 2026-10-07 (was root with both
# growth.env and the API .env): the only job user in adm/systemd-journal, which
# it needs for the nginx logs and journalctl -u findacrib-api. errors.env holds
# the findacrib.com mailbox SMTP (Google refuses the API .env's Gmail login
# from this droplet, 535 on 2026-10-06), the service key and the recipient.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=America/New_York
25 * * * * facops cd /root/Find-A-Crib && fac-run errors -- python3 error_report.py --hours 1 >> /var/log/rentmap-errors.log 2>&1
10 8 * * * facops cd /root/Find-A-Crib && fac-run errors -- python3 error_report.py --hours 24 --digest >> /var/log/rentmap-errors.log 2>&1
