    "Neighborhood, price, bedrooms, anything — e.g. “2 bed under $2,500 near Prospect Park, no violations”." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Barrio, precio, dormitorios, cualquier cosa, por ejemplo: \"2 dormitorios por menos de 2.500 dólares cerca del Parque Prospect, sin infracciones\"."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "동네, 가격, 침실, 무엇이든 - 예를 들어 \"프로젝트 파크 근처 2베드룸, 2,500달러 이하, 위반 없음\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "社区、价格、卧室、任何东西——例如“Prospect Park附近2间卧室，价格低于2500美元，没有违规”。"
