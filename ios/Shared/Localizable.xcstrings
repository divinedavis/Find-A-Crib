    "Pick at least one borough." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige al menos un borough."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "적어도 한 개의 자치구를 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
