    "Sign in to join your building's chat. Messages are end-to-end encrypted: only the people in the chat can read them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión para unirte al chat de tu edificio. Los mensajes tienen cifrado de extremo a extremo: solo las personas del chat pueden leerlos."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인하고 건물 채팅에 참여하세요. 메시지는 종단 간 암호화되어 채팅 참여자만 읽을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录即可加入你所在楼的聊天。消息端到端加密：只有聊天里的人能读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入即可加入你所在大樓的聊天。訊息端對端加密：只有聊天裡的人能讀。"
          }
        }
      }
    },
    "Sign in to see the full history" : {
      "localizations" : {
        "es" : {
