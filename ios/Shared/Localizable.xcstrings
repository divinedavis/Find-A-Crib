        }
      }
    },
    "Income-restricted apartments that HPD-approved marketing agents are re-renting, from their own websites. Apply through the agent. Bedroom sizes come from each listing's own unit table." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apartamentos con restricciones de ingresos que los agentes de marketing aprobados por HPD están rearrendando, desde sus propios sitios web. Solicite a través del agente. Los tamaños de las habitaciones provienen de la tabla de unidades de cada anuncio."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HPD가 승인한 마케팅 에이전트가 자체 웹사이트에서 재임대하는 소득 제한 아파트. 에이전트를 통해 신청하세요. 침실 크기는 각 목록의 자체 단위 테이블에서 따릅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HPD批准的营销代理人在自己的网站上重新出租收入受限的公寓。通过代理人申请。卧室尺寸来自每个列表的自己的单元表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HPD批准的營銷代理正在從自己的網站重新出租收入受限的公寓。透過代理人申請。臥室尺寸來自每個列表的單元表。"
          }
        }
      }
    },
    "Income-restricted building" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edificio con límite de ingresos"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "소득 제한 건물"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
