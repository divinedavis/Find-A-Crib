    "County" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Condado"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카운티"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "县"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "郡"
          }
        }
      }
    },
    "Covered by the San Francisco Rent Ordinance and reported to the Rent Board by the owner. Reports are anonymised to the block, so this pin is a block-side of rent-controlled units rather than one address." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cubierto por la Ordenanza de Alquiler San Francisco y reportado a la Junta de Alquiler por el propietario. Los informes se anoniman al bloque, por lo que este pin es un lado del bloque de unidades con control de alquiler en lugar de una dirección."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "San Francisco 임대 조례에 따라 규정되며 소유자가 임대 위원회에 보고합니다. 보고서는 블록에 대해 익명으로 처리되므로 이 핀은 하나의 주소가 아니라 임대 통제 단지의 블록 측면입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "受San Francisco租金条例的涵盖，由业主向租金委员会报告。报告对街区进行匿名化，因此此针脚是租金受控单元的街区侧，而不是一个地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "受San Francisco租金條例的約束，業主應向租金委員會報告。報告將匿名化到街區，因此此針腳是受租金管制的單元的一側街區，而不是一個地址。"
          }
        }
      }
    },
    "Covers citations from %@ to %@ — %@'s file is a rolling window, not an all-time register." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Covers citations from %1$@ to %2$@ — %3$@'s file is a rolling window, not an all-time register."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cubre citas de %1$@ a %2$@: el archivo de %3$@ es una ventana móvil, no un registro completo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@에서 %2$@까지의 인용문을 다룹니다. %3$@의 파일은 역대 기록이 아닌 롤링 윈도우입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "涵盖从%1$@到%2$@的引用——%3$@的文件是一个滚动窗口，而不是一个所有时间注册表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "涵蓋從%1$@到%2$@的引用——%3$@的檔案是一個滾動視窗，而不是歷史記錄。"
          }
        }
      }
    },
