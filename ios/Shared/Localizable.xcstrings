    "New lotteries and re-rentals in the boroughs you pick" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nuevas loterías y re-alquileres en los condados que elijas"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "당신이 선택한 자치구에서 새로운 추첨과 재임대"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
