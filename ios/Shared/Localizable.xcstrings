    "%@ — what the register has on file, not an asking rent. Buildings with no rent on file are not shown when you set a price." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@: lo que tiene el registro en archivo, no un alquiler solicitado. Los edificios sin alquiler en archivo no se muestran cuando se establece un precio."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ - 등록부에 기록되어 있는 내용, 임대료가 아닌 내용입니다. 등록부에 임대료가 없는 건물은 가격을 설정할 때 표시되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@——登记处存档的内容，而不是要求的租金。当您设置价格时，没有存档租金的建筑物将不显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@——登記處存檔的內容，而不是要求的租金。當您設定價格時，沒有存檔租金的建築物不會顯示。"
          }
        }
      }
    },
